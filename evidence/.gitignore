# Node
node_modules/

# Evidence build output (regenerated by npm run build)
build/
.svelte-kit/

# Evidence dev cache - ignore everything in .evidence/ EXCEPT the parquet data layer.
# That data layer is what Netlify uses to render the deployed dashboard.
.evidence/*
!.evidence/template/
.evidence/template/*
!.evidence/template/static/
.evidence/template/static/*
!.evidence/template/static/data/

# Local DuckDB files committed for sources (not needed in repo if you commit parquet)
sources/olist/*.duckdb
sources/olist/*.duckdb.wal